{"chunk_id": "chunk_620b218ba745a7b6cb358450", "paper_id": "arxiv_2002.05202", "arxiv_id": "2002.05202", "paper_title": "GLU Variants Improve Transformer", "citation": "", "version": "v1", "source_format": "html", "source_url": "https://arxiv.org/html/2002.05202v1", "source_path": "data/corpus_78/html/arxiv_2002.05202v1.html", "source_sha256": "f5af33eda58f3e7885acc01119a0cd126b45c623e0e73bda35997d596310f26a", "section_id": "arxiv_2002.05202_v1_s0007", "section_title": "4 Conclusions", "section_path": ["4 Conclusions"], "section_kind": "body", "merged_section_titles": [], "section_chunk_index": 0, "char_start": 0, "char_end": 512, "offset_scope": "normalized_section_text", "text": "We have extended the GLU family of layers and proposed their use in Transformer. In a transfer-learning setup, the new variants seem to produce better perplexities for the de-noising objective used in pre-training, as well as better results on many downstream language-understanding tasks. These architectures are simple to implement, and have no apparent computational drawbacks. We offer no explanation as to why these architectures seem to work; we attribute their success, as all else, to divine benevolence.", "token_count": 118, "tokenizer": "BAAI/bge-m3", "page_numbers": [], "content_types": ["text"], "source_spans": [{"paragraph_id": "p_b236fc803ac6a28d7898", "page": null, "bbox": null, "element_id": "S4.p1.1", "paragraph_kind": "text", "paragraph_char_start": 0, "paragraph_char_end": 512, "section_char_start": 0, "section_char_end": 512}], "parser_quality_flags": [], "chunker_version": "recursive-spans-v2", "config_id": "0681cd4251ed", "previous_chunk_id": null, "next_chunk_id": null}
